# Environment setup template
# ------------------------------------------------------------
# Required files:
#   - .env           (perfil activo por defecto)
#   - .env.dev       (perfil desarrollo)
#   - .env.test      (perfil pruebas CI/local)
#   - .env.prod      (perfil producción)
# Copia el contenido de cada sección en el archivo correspondiente
# y sustituye los placeholders con valores reales.

## Variables comunes (copiar en todos los archivos si aplican)
# Ruta al archivo de semillas opcional para usuarios de gastos. Usa la ruta interna del contenedor
# cuando dependas de Docker (por defecto /workspace/scripts/secrets/register_users_payloads.jsonl).
REGISTER_USERS_SEED_FILE=/workspace/scripts/secrets/register_users_payloads.jsonl

## .env (entorno local por defecto)
# APP_JWT_SECRET debe tener al menos 64 caracteres para algoritmos HS512. En dev/test, docker-compose 
# proporciona un valor por defecto si no se configura, pero en producción es OBLIGATORIO.
POSTGRES_PASSWORD=<local-db-password>
SPRING_DATASOURCE_PASSWORD=<local-db-password>
SPRING_DATASOURCE_USERNAME=<local-db-username>
SPRING_DATASOURCE_URL=jdbc:postgresql://<local-db-host>:5432/<local-db-name>
APP_JWT_SECRET=<local-jwt-secret-min-64-chars>

## .env.dev (desarrollo)
# APP_JWT_SECRET opcional para dev - docker-compose usa un valor por defecto si no se configura
POSTGRES_PASSWORD=<dev-db-password>
SPRING_DATASOURCE_PASSWORD=<dev-db-password>
SPRING_DATASOURCE_USERNAME=<dev-db-username>
SPRING_DATASOURCE_URL=jdbc:postgresql://<dev-db-host>:5432/<dev-db-name>
APP_JWT_SECRET=<dev-jwt-secret-min-64-chars>

## .env.test (tests locales o CI)
# APP_JWT_SECRET opcional para test - docker-compose usa un valor por defecto si no se configura
POSTGRES_PASSWORD=<test-db-password>
SPRING_DATASOURCE_PASSWORD=<test-db-password>
SPRING_DATASOURCE_USERNAME=<test-db-username>
SPRING_DATASOURCE_URL=jdbc:postgresql://<test-db-host>:5432/<test-db-name>
APP_JWT_SECRET=<test-jwt-secret-min-64-chars>

## .env.prod (producción)
# APP_JWT_SECRET es OBLIGATORIO en producción - no hay valor por defecto por seguridad
# Debe ser una cadena aleatoria de al menos 64 caracteres
POSTGRES_PASSWORD=<prod-db-password>
SPRING_DATASOURCE_PASSWORD=<prod-db-password>
SPRING_DATASOURCE_USERNAME=<prod-db-username>
SPRING_DATASOURCE_URL=jdbc:postgresql://<prod-db-host>:5432/<prod-db-name>
APP_JWT_SECRET=<prod-jwt-secret-min-64-chars-REQUIRED>

# Notas:
# - Mantén solo este archivo (.env.example) versionado como guía; todos los archivos .env* reales se ignoran con .gitignore para proteger credenciales.
# - Usa contraseñas únicas y tokens fuertes en cada entorno.
# - APP_JWT_SECRET: Genera secretos seguros con: openssl rand -base64 64 | tr -d '\n'
# - En entornos dev/test, docker-compose proporciona valores por defecto para facilitar el desarrollo.
# - En producción, APP_JWT_SECRET es OBLIGATORIO y debe ser único y seguro.
